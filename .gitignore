# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Emitted JS from tsc in the React source tree (the source of truth is .ts/.tsx)
frontend/src/**/*.js
!frontend/vite.config.ts.js

# Editor — keep shared .vscode debug config, ignore only user-local files
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
