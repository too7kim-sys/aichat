[Unit]
# aichat FastAPI backend. Ollama·nginx 는 별도 서버이므로 의존성에서 제외.
# qdrant 는 같은 박스의 docker 컨테이너 — qdrant.service 로 systemd 가
# 감싸뒀으므로 After=qdrant.service 로 잡아두고, Wants= 로 자동 동반
# 기동되게 한다.
Description=aichat FastAPI backend
Documentation=https://github.com/too7kim-sys/aichat
After=network-online.target docker.service qdrant.service
Wants=network-online.target qdrant.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/data/projects/aichat/backend
EnvironmentFile=/data/projects/aichat/backend/.env

# uvicorn — 내부망 127.0.0.1 만 listen (외부 노출은 별도 서버의 nginx 가 담당)
ExecStart=/data/projects/aichat/backend/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 9000 \
    --workers 2 \
    --no-access-log \
    --timeout-keep-alive 75 \
    --proxy-headers

Restart=on-failure
RestartSec=3
LimitNOFILE=65536

# 로그를 journald + 파일로 동시 송출
StandardOutput=append:/data/projects/aichat/logs/backend.out.log
StandardError=append:/data/projects/aichat/logs/backend.err.log

[Install]
WantedBy=multi-user.target
