# Naver Search Open API (free 25,000/day per app).
# Register at https://developers.naver.com/main/ -> "Application" ->
# "Application 등록" with "검색" service. Copy the issued client id/secret.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
DATABASE_URL=sqlite+aiosqlite:///./aichat.db
CORS_ORIGINS=http://localhost:5173

# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS/Linux: leave empty if 'tesseract' is on PATH
TESSERACT_CMD=
OCR_LANGUAGES=eng+kor
MAX_UPLOAD_BYTES=5242880
MAX_ATTACHMENT_CHARS=50000

# Conversation context window: only the most recent N persisted messages
# (user + assistant) are sent to the LLM on each turn. Lower this if you
# hit the model's context limit on long conversations.
MAX_HISTORY_MESSAGES=30

# Auth - generate a strong random secret for non-local use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=336

# Email delivery (verification + password reset).
# Leave SMTP_HOST empty to print links to the server log instead of
# actually sending — handy when you have no SMTP account yet.
#
# Gmail example (requires 2FA + App Password from myaccount.google.com):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<App Password>
#   SMTP_FROM=you@gmail.com
#   SMTP_USE_TLS=true
#
# Brevo (sendinblue) example:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USERNAME=<your-brevo-login>
#   SMTP_PASSWORD=<smtp key>
#   SMTP_FROM=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Where verify / reset email links should land in the browser.
APP_BASE_URL=http://localhost:5173

VERIFY_TOKEN_HOURS=24
RESET_TOKEN_HOURS=1

