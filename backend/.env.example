# Naver Search Open API (free 25,000/day per app).
# Register at https://developers.naver.com/main/ -> "Application" ->
# "Application 등록" with "검색" service. Copy the issued client id/secret.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Ollama context length: the floor used for short chats and the cap the
# server may grow up to when a big attachment lands. Ollama's own
# default is 2048 — far too small for code analysis. Floor 8k is fine
# for normal chat; raise the cap if your model supports more context.
#   - llama3.1 / qwen2.5-coder       : up to 128k
#   - qwen3                          : up to 32k
#   - deepseek-r1                    : up to 128k
# MSI EdgeXpert (DGX Spark, 128 GB unified memory): use the values in
# the EdgeXpert preset block at the bottom of this file.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_CTX_MAX=32768

# Generation knobs — lower values produce more deterministic, less
# "creative" output, which is what we want for code review and
# vulnerability analysis (creative = hallucinated function names,
# made-up CVE numbers, etc.). Set to -1 to fall back to the model's
# built-in default.
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.05

# Anti-hallucination system prompt. When true (default), the chat
# router prepends a strict ruleset that tells the model to say "I
# don't know" instead of inventing function names / file paths /
# line numbers / CVE IDs / API signatures, to cite a `path:line` or
# search-result number for every claim, and to mark unverifiable
# library or version details as "공식 문서 확인 필요". Turn off only
# if you're already using a tightly tuned model and want the context
# budget back.
ACCURACY_STRICT=true

# Free-form text appended as an additional system message on every
# request. Use this for house style, domain glossary, escalation
# rules, or any standing instruction you'd otherwise repeat in every
# prompt. Multi-line is fine — just keep it on one line in .env with
# \n for newlines (Pydantic Settings keeps it as a single string).
#   Example:
#   SYSTEM_PROMPT_EXTRA="모든 보안 발견에 OWASP 또는 CWE 카테고리를 함께 표시하세요."
SYSTEM_PROMPT_EXTRA=

# Auto model routing. When the model picker is set to "🤖 자동",
# the chat router classifies the prompt + attachments and picks one
# of these. Leave a value blank to fall back to OLLAMA_MODEL. The
# server lifts num_ctx cap to each picked model's native limit
# (qwen3-coder=256K, qwen3=32K, exaone=32K, llama3.x=128K, ...) so
# OLLAMA_NUM_CTX_MAX only matters for manually selected models.
#   - code attachment OR "취약점/리뷰/디버깅/리팩토/구현" 의도 → MODEL_AUTO_CODE
#   - "왜/원인/분석/증명/단계별로" 의도                      → MODEL_AUTO_REASONING
#   - 30 KB 이상 첨부                                       → MODEL_AUTO_CODE
#   - 그 외                                                 → MODEL_AUTO_GENERAL
# EdgeXpert / DGX Spark suggestion (qwen3-coder + qwen3 + exaone3.5):
#   MODEL_AUTO_CODE=qwen3-coder:30b
#   MODEL_AUTO_REASONING=qwen3:32b
#   MODEL_AUTO_GENERAL=exaone3.5:32b
MODEL_AUTO_CODE=
MODEL_AUTO_REASONING=
MODEL_AUTO_GENERAL=
# Vision model for image attachments (📷 사진/스크린샷 분석). When set,
# image attachments are forwarded to this model as base64 — OCR text
# still rides along for the text-only fallback path. Pull once with
# e.g. `ollama pull qwen2.5vl:7b` on the Ollama host.
# Tested options:
#   qwen2.5vl:7b      ~5 GB   — fast, strong on diagrams and Korean
#   qwen2.5vl:32b     ~20 GB  — best quality if memory allows
#   llama3.2-vision:11b  ~8 GB
#   gemma3:12b        ~8 GB   — vision + 128K context
MODEL_AUTO_VISION=

# Code workspaces — persistent per-user git clones the Code tab
# browses and (eventually) commits + pushes back to. Phase 1
# supports view + attach-to-chat; the IDE / agent loop comes later.
#
# WORKSPACE_DIR: filesystem root for the clones. Each user gets
#   their own subdirectory so two users never see each other's repos.
#   On Windows use forward slashes: C:/Users/i/git/aichat/workspaces
WORKSPACE_DIR=./workspaces
# Fernet key (32-byte URL-safe base64). Used to encrypt the per-
# workspace PAT / password at rest. Leaving it blank falls back to
# JWT_SECRET, but rotating JWT_SECRET later would silently break
# every saved workspace credential — set this once and keep stable.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WORKSPACE_SECRET=
# Comma-separated host allow-list for git URLs. EMPTY = any host is
# allowed (fine on a closed network where the LAN is trusted). For
# mixed internal+external repos, list every host you actually use:
#   WORKSPACE_ALLOWED_HOSTS=github.com,gitlab.com,gitlab.internal,gitea.lan
WORKSPACE_ALLOWED_HOSTS=
WORKSPACE_MAX_SIZE_MB=500
WORKSPACE_MAX_FILES=5000
WORKSPACE_CLONE_DEPTH=50
# Local-folder workspace source — register a directory the server can
# already see, no git clone. EMPTY = the feature is OFF (creating a
# local-folder workspace returns a clear error message). When the
# backend runs on the same machine as the user, set this to one or
# more parent directories the user wants to expose:
#   WORKSPACE_LOCAL_ROOTS=/home/user/projects,/srv/work,~/Desktop
# Symlinks are resolved before the check, so a path under one of the
# allowed roots can't sneak into /etc via a link. If the registered
# folder has a .git directory, commit + push work the same as clone
# sources, but use whatever git auth the working tree already has
# configured (SSH keys, credential helper).
WORKSPACE_LOCAL_ROOTS=

# Chat 자동 첨부 한도 — 코드 모드 채팅이 매 턴마다 워크스페이스에서 골라
# 프롬프트에 끼우는 파일 개수 / 단일 파일 바이트 / 합계 바이트.
# 세 가지 중 어느 한도라도 먼저 닿으면 거기서 멈춥니다.
# 기본값은 32K 컨텍스트 모델에 안전한 수준. 그룹웨어처럼 400+ 파일 프로젝트는
# WORKSPACE_BUNDLE_MAX_FILES 를 600~1000 정도로 올리면 됩니다 (모델 컨텍스트
# 충분한지 확인). 단일 파일이 자주 잘리면 PER_FILE 을 키우세요.
WORKSPACE_BUNDLE_MAX_FILES=300
WORKSPACE_BUNDLE_MAX_BYTES_PER_FILE=307200
WORKSPACE_BUNDLE_MAX_TOTAL_BYTES=8388608

# RAG / 코드 검색 (전자정부프레임워크 같은 큰 코드베이스 통째 분석)
# 사용 흐름:
#   1) ollama pull bge-m3                         # 임베딩 모델 (한 번)
#   2) 우측 헤더 📚 버튼 → 프로젝트 추가
#   3) Git URL 또는 서버 폴더 경로 + 이름 → 인덱싱 시작
#   4) 인덱싱 끝나면 "이 채팅에 연결" 클릭
#   5) 일반 질문 입력 → 자동으로 관련 코드 청크 검색해서 답변
#
# RAG_QDRANT_PATH는 백엔드가 자동 생성하는 폴더. 다른 PC의 Qdrant
# 서버를 쓰려면 RAG_QDRANT_URL=http://host:6333 으로 채우세요.
RAG_ENABLED=true
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_DIM=1024
RAG_QDRANT_PATH=./qdrant_data
RAG_QDRANT_URL=
RAG_CHUNK_LINES=200
RAG_CHUNK_OVERLAP=30
RAG_TOP_K=12
RAG_MAX_FILES=5000
RAG_MAX_BYTES_PER_FILE=1048576

DATABASE_URL=sqlite+aiosqlite:///./aichat.db
CORS_ORIGINS=http://localhost:5173

# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS/Linux: leave empty if 'tesseract' is on PATH
TESSERACT_CMD=
OCR_LANGUAGES=eng+kor
MAX_UPLOAD_BYTES=5242880
MAX_ATTACHMENT_CHARS=50000

# Conversation context window: only the most recent N persisted messages
# (user + assistant) are sent to the LLM on each turn. Lower this if you
# hit the model's context limit on long conversations.
MAX_HISTORY_MESSAGES=30

# Auth - generate a strong random secret for non-local use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=336

# Email delivery (verification + password reset).
# Leave SMTP_HOST empty to print links to the server log instead of
# actually sending — handy when you have no SMTP account yet.
#
# Gmail example (requires 2FA + App Password from myaccount.google.com):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<App Password>
#   SMTP_FROM=you@gmail.com
#   SMTP_USE_TLS=true
#
# Brevo (sendinblue) example:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USERNAME=<your-brevo-login>
#   SMTP_PASSWORD=<smtp key>
#   SMTP_FROM=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Where verify / reset email links should land in the browser.
APP_BASE_URL=http://localhost:5173

VERIFY_TOKEN_HOURS=24
RESET_TOKEN_HOURS=1

# =============================================================================
# MSI EdgeXpert (NVIDIA DGX Spark, 128 GB unified memory) — recommended preset
# =============================================================================
# Three-model lineup: qwen3-coder:30b (code, 256K ctx, MoE 3.3B 활성 → 빠름)
#                   + qwen3:32b      (reasoning, <think> 사고과정 패널)
#                   + exaone3.5:32b  (general 한국어 최적화)
# Memory budget on 128 GB: ~58 GB weights + KV(Q8) ~30 GB + OS 8 GB ≈ 96 GB.
# All three can stay hot simultaneously.
#
# Copy the values below into your backend/.env:
#
#   OLLAMA_BASE_URL=http://<edgexpert-lan-ip>:11434
#   OLLAMA_MODEL=exaone3.5:32b          # 한국어 일반 폴백
#   MODEL_AUTO_CODE=qwen3-coder:30b
#   MODEL_AUTO_REASONING=qwen3:32b
#   MODEL_AUTO_GENERAL=exaone3.5:32b
#   OLLAMA_NUM_CTX=16384                # short chats stay snappy
#   OLLAMA_NUM_CTX_MAX=32768            # 수동 선택용 안전 한도
#                                       # (자동 라우팅은 모델 네이티브 한도 자동 적용)
#   OLLAMA_TEMPERATURE=0.2              # tighter for code review / 보안 점검
#   OLLAMA_TOP_P=0.9
#   OLLAMA_REPEAT_PENALTY=1.05
#   ACCURACY_STRICT=true
#   MAX_HISTORY_MESSAGES=40
#   MAX_ATTACHMENT_CHARS=200000
#
# 모델 미리 받기:
#   ollama pull qwen3-coder:30b
#   ollama pull qwen3:32b
#   ollama pull exaone3.5:32b
#
# On the EdgeXpert itself, set the Ollama daemon env vars so the server
# uses the hardware. Put these in /etc/systemd/system/ollama.service.d/
# override.conf (see ops/edgexpert-ollama.service.conf for a copy-
# pasteable file in this repo):
#
#   Environment="OLLAMA_HOST=0.0.0.0:11434"
#   Environment="OLLAMA_NUM_PARALLEL=4"
#   Environment="OLLAMA_MAX_LOADED_MODELS=3"   # 세 모델 모두 상주
#   Environment="OLLAMA_KEEP_ALIVE=24h"
#   Environment="OLLAMA_FLASH_ATTENTION=1"
#   Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
#
# Then: sudo systemctl daemon-reload && sudo systemctl restart ollama


# =============================================================================
# 회의록·강의 전사 (선택 기능) — 폐쇄망(오프라인) 설치
# =============================================================================
# 폐쇄망에서는 모델을 미리 받아 옮겨야 합니다. 두 단계로 진행합니다.
#
# ── [A] 인터넷 되는 PC에서 모델 받기 ──────────────────────────────────
#   pip install huggingface_hub
#
#   # 1) Whisper (faster-whisper용 CTranslate2 모델)
#   huggingface-cli download Systran/faster-whisper-large-v3 ^
#       --local-dir C:\models\faster-whisper-large-v3
#
#   # 2) (선택) 화자 분리 pyannote — HF 계정 로그인 + 아래 두 모델
#   #    페이지에서 "Agree and access" 클릭 후:
#   #    https://huggingface.co/pyannote/speaker-diarization-3.1
#   #    https://huggingface.co/pyannote/segmentation-3.0
#   set HF_TOKEN=hf_xxxxx
#   huggingface-cli download pyannote/speaker-diarization-3.1 ^
#       --local-dir C:\models\pyannote-diar
#   huggingface-cli download pyannote/segmentation-3.0 ^
#       --local-dir C:\models\pyannote-seg
#
#   → C:\models 폴더 전체를 USB로 폐쇄망 서버에 복사
#
# ── [B] 폐쇄망 서버 설정 ──────────────────────────────────────────────
#   pip install faster-whisper            # 전사 (필수)
#   pip install pyannote.audio            # 화자 분리 (선택)
#
#   ENABLE_TRANSCRIPTION=true
#   TRANSCRIPTION_OFFLINE=true            # ← 폐쇄망 핵심: 허브 접속 차단
#   # WHISPER_MODEL 에 "이름" 대신 복사해둔 로컬 폴더 절대경로를 지정:
#   WHISPER_MODEL=C:/models/faster-whisper-large-v3
#   WHISPER_DEVICE=auto                  # GPU 있으면 cuda 자동
#   WHISPER_COMPUTE_TYPE=float16         # CPU면 자동 int8
#
#   # 화자 분리 (선택, 위 [A]-2 까지 받았을 때만)
#   ENABLE_DIARIZATION=true
#   HF_TOKEN=hf_xxxxx                    # 캐시 인증용 (오프라인이어도 필요)
#
#   TRANSCRIPTION_MAX_UPLOAD_MB=200
#   TRANSCRIPTION_SUMMARY_MODEL=exaone3.5:32b   # 비우면 OLLAMA_MODEL
#
# TRANSCRIPTION_OFFLINE=true 이면 모델을 못 찾을 때 즉시 명확한 에러를
# 내고, 절대 인터넷 연결을 시도하지 않습니다. 화자 분리가 폐쇄망에서
# 번거로우면 ENABLE_DIARIZATION=false 로 두고 전사+요약만 먼저
# 쓰셔도 됩니다 (화자 라벨만 빠지고 나머지는 동일).
